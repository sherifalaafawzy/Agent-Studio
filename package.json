{
  "name": "agent-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Model-agnostic desktop agent app (Next.js + FastAPI/ADK + Electron shell)",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cd backend && .venv\\Scripts\\python -m uvicorn app.main:create_app --factory --host 127.0.0.1 --port 8765 --reload",
    "dev:web": "npm --prefix frontend run dev",
    "dev:desktop": "concurrently -k -n api,web,app -c yellow,cyan,magenta \"npm:dev:api\" \"npm:dev:web\" \"npm --prefix electron run dev\"",
    "test": "cd backend && .venv\\Scripts\\python -m pytest -q -W ignore",
    "demo:cap": "backend\\.venv\\Scripts\\python scripts\\demo_cap_guard.py",
    "demo:p2": "backend\\.venv\\Scripts\\python scripts\\demo_phase2.py",
    "check:mcp": "backend\\.venv\\Scripts\\python scripts\\check_mcp.py",
    "build:sandbox": "docker build -t agent-studio-sandbox:1 docker/sandbox"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}